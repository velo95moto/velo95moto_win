{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Velo95Moto",
  "version": "0.1.18",
  "identifier": "com.velo95moto.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Velo95Moto",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 560,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "RWRSceJkfhEpxYenq/bV8hVU/rJDxDJUM2X5AxQBtv9HPInMkPnGGrcJ",
      "endpoints": [
        "https://github.com/velo95moto/velo95moto_win/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
